generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Int
  images      String[]
  inventory   Int
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  address      String
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  qty              Int
  priceAtPurchase  Int
  order            Order    @relation(fields: [orderId], references: [id])
  product          Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
